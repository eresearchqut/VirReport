includeConfig 'conf/base.config'

params {
  outdir = 'results'
  indexfile = 'index.csv'
  run_viral_db_blast = true
  run_nt_blast = false
  blastn_evalue = '0.0001'
  blastn_method = 'megablast'
  run_blastx = false
  blastx_evalue = '0.01'
  bowtie_db_dir = null
  cap3_len = 40
  report_viral_db_detections = false
  report_nt_detections = false
  blastn_viral_db_path = null
  blastn_db_path = null
  blastp_db_path = null
  virus_detect_db_path = null
  contamination_flag = '0.01'
  dedup = false
  help = false
  maxlen = 22
  merge_lane = false
  minlen = 21
  negative_seqid_list = "${projectDir}/bin/negative_list_out.txt"
  orf_minsize = 90
  orf_circ_minsize = 90
  qualityfilter = false
  spadesmem = 32
  targets = false
  targets_file = "${projectDir}/bin/Targetted_Viruses_Viroids.txt"
  tblastn_evalue = '0.0001'
  diagno = false
  blastx_len = 105
  rna_source_profile = false
  synthetic_oligo_screen = false
  use_sampleinfo = false
  sampleinfo_path = null
  samplesheet_path = null
  run_virus_detect = false
  virus_depth_cutoff = 2
}

process.container = "ghcr.io/eresearchqut/virreport:v2.0.0"

process {
  errorStrategy = 'retry'
  maxRetries = 2
  maxErrors = 2
}

profiles {
  docker {
    docker.enabled = true
  }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.pullTimeout = '1h'
  }
  test { 
    includeConfig "conf/test.config"
  }

  test2 {
    includeConfig "conf/test2.config"
  }
}

manifest {
  name          = "eresearchqut/VirReport"
  author        = "Marie-Emilie Gauthier"
  defaultBranch = "main"
  description   = "VirReport is designed to help phytosanitary diagnostics of viruses and viroid pathogens in quarantine facilities. It takes small RNA-Seq samples as input."
  version       = "v2.0.0"
}
